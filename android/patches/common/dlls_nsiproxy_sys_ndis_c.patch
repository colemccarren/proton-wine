+#ifdef __ANDROID__
+/* Read the active (first non-loopback) interface name from /proc/net/route, which stays
+ * readable under the Android app sandbox even when interface enumeration does not expose the
+ * interface. Android often keeps the default route in a separate table not visible here, so we
+ * accept any on-link route on a real interface rather than requiring a default route. */
+static BOOL android_active_iface( char *name, size_t len )
+{
+    FILE *fp;
+    char buf[512];
+    BOOL found = FALSE;
+
+    if (!(fp = fopen( "/proc/net/route", "r" ))) return FALSE;
+    if (!fgets( buf, sizeof(buf), fp )) { fclose( fp ); return FALSE; } /* header */
+    while (fgets( buf, sizeof(buf), fp ))
+    {
+        char iface[IFNAMSIZ];
+        if (sscanf( buf, "%15s", iface ) < 1) continue;
+        if (!strcmp( iface, "lo" )) continue;
+        {
+            size_t n = strlen( iface ); /* iface is <= 15 chars from %15s */
+            if (n > len - 1) n = len - 1;
+            memcpy( name, iface, n );
+            name[n] = 0;
+        }
+        found = TRUE;
+        break;
+    }
+    fclose( fp );
+    return found;
+}
+#endif /* __ANDROID__ */
